opam-version: "2.0"
maintainer: "Robur <team@robur.coop>"
authors: ["Robur <team@robur.coop>"]
homepage: "https://github.com/robur-coop/blame"
dev-repo: "git+https://github.com/robur-coop/blame.git"
bug-reports: "https://github.com/robur-coop/blame/issues"
license: "MIT"

depends: [
  "ocaml" {>= "5.3.0"}
  "dune" {>= "3.0.0"}
  "vif" {= version}
  "mhttp"
  "mirage-crypto-rng-mkernel"
  "vifu"
]
conflicts: [ "result" {< "1.5"} ]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
]
run-test: [
  [ "dune" "runtest" "-p" name "-j1" ]
]
synopsis: "A self-contained unikernel to provide a search engine from an archive of emails"
x-ci-accept-failures: ["debian-11"]
