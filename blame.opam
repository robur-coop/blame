opam-version: "2.0"
maintainer: "Robur <team@robur.coop>"
authors: ["Robur <team@robur.coop>"]
homepage: "https://github.com/robur-coop/blame"
dev-repo: "git+https://github.com/robur-coop/blame.git"
bug-reports: "https://github.com/robur-coop/blame/issues"
license: "MIT"

depends: [
  "ocaml" {>= "5.3.0"}
  "dune" {>= "3.0.0"}
  "vif" {= version}
  "mhttp"
  "mirage-crypto-rng-mkernel"
  "emile"
  "cmdliner"
  "logs"
  "fmt"
  "fpath"
  "hxd"
  "gmp"
  "jsont"
  "digestif"
  "rosetta"
  "encore"
  "vifu"
]
conflicts: [ "result" {< "1.5"} ]
build: [
  ["dune" "subst"] {dev}
  ["./source.sh"]
  ["dune" "build" "-p" name "-j" jobs]
  ["./install.sh"]
]
synopsis: "A self-contained unikernel to provide a search engine from an archive of emails"
x-ci-accept-failures: ["debian-11"]
pin-depends: [
  [ "mirage-crypto.2.0.2" "git+https://github.com/dinosaure/mirage-crypto.git#820db4c1d19acd06dca82ce5615904848a852951" ]
  [ "mirage-crypto-ec.2.0.2" "git+https://github.com/dinosaure/mirage-crypto.git#820db4c1d19acd06dca82ce5615904848a852951" ]
