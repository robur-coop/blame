(executable
 (name crunch)
 (modules crunch)
 (enabled_if (= %{context_name} "default"))
 (libraries
  hxd.core
  hxd.string
  cmdliner
  fmt
  fmt.tty
  fmt.cli
  logs
  logs.fmt
  logs.cli
  fpath))

(executable
 (name main)
 (modules main documents)
 (link_flags :standard -cclib "-z solo5-abi=hvt")
 (libraries
  blame.emails
  blaze.stem
  stem.tokenizer
  stem.snowball
  stem.stopwords
  gmp
  mirage-crypto-rng-mkernel
  vifu)
 (foreign_stubs
  (language c)
  (names manifest)))

(executable
 (name script)
 (modules script)
 (modes js)
 (libraries jsont.brr brr blame.format))

(rule
 (targets script.js)
 (deps script.bc.js)
 (action (copy script.bc.js script.js)))

(library
 (name format)
 (public_name blame.format)
 (modules format)
 (libraries fmt rosetta emile ptime jsont))

