(library
 (name emails)
 (public_name blame.emails)
 (modules emails)
 (libraries blame.format jsont hxd.core hxd.string emile blaze.email digestif mkernel carton-miou.flux))

(rule
 (targets manifest.c)
 (enabled_if
  (= %{context_name} "default"))
 (action
  (write-file manifest.c "")))

(rule
 (targets manifest.c)
 (deps manifest.json)
 (enabled_if
  (= %{context_name} "solo5"))
 (action
  (run solo5-elftool gen-manifest manifest.json manifest.c)))

(rule
 (targets manifest.json)
 (enabled_if
  (= %{context_name} "solo5"))
 (action
  (with-stdout-to
   manifest.json
   (run %{exe:main.exe} --ipv4=0.0.0.0/24))))

(rule
 (targets documents.ml)
 (deps index.html script.js)
 (action
  (with-stdout-to
    documents.ml
    (run %{exe:crunch.exe} --with-comments --file index.html --file script.js))))

(vendored_dirs vendors)
